# =========================================================================
#  MARKETING INTELLIGENCE AGENT CONFIGURATION
# =========================================================================

# --- 1. Telegram Dispatch Configuration ---
# 1. Create a bot with @BotFather on Telegram to get your TELEGRAM_BOT_TOKEN
# 2. Get your personal Chat ID by messaging @userinfobot or @raw_data_bot on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 2. Email (SMTP) Dispatch Configuration ---
# For Gmail:
#   - SMTP_HOST: smtp.gmail.com
#   - SMTP_PORT: 587
#   - SMTP_USER: your_email@gmail.com
#   - SMTP_PASSWORD: 16-character App Password (generate at https://myaccount.google.com/apppasswords)
#   - EMAIL_TO: destination_email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
SMTP_USE_SSL=false

# --- 3. Optional Settings ---
MAX_ARTICLES_PER_FEED=8
MAX_TOTAL_ARTICLES_PER_SECTION=6
